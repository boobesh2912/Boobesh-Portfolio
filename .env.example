# Copy to .env.local for local dev, or set these in Vercel project settings.
# Never commit real values.

# Admin login, protects /admin
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# GitHub token with repo write access. The admin desk uses it to publish blog
# posts, speaking events, sites and uploaded images by committing them to the
# repo. Without it, publishing is switched off and the desk says so.
GITHUB_TOKEN=
GITHUB_OWNER=boobesh2912
GITHUB_REPO=Boobesh-Portfolio
GITHUB_BRANCH=main

# Contact form delivery. With a Resend key the note is emailed to CONTACT_TO
# straight away. With GITHUB_TOKEN set it is also filed under content/inbox so
# nothing is lost if mail delivery fails. Set at least one of the two or the
# form tells people to mail directly instead.
RESEND_API_KEY=
CONTACT_TO=dreamsofboo@gmail.com
# Must be a domain verified in Resend. onboarding@resend.dev works for testing.
CONTACT_FROM=onboarding@resend.dev
