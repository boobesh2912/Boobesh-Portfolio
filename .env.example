# Copy to .env.local for local dev, or set these in Vercel project settings.
# Never commit real values.

# Blog admin login (protects /admin)
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# GitHub token with repo write access, used by /admin to publish new blog
# posts by committing markdown files directly to content/blog/
GITHUB_TOKEN=
GITHUB_OWNER=boobesh2912
GITHUB_REPO=Boobesh-Portfolio
